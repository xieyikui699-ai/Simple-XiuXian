{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "ignore": [
      "**/dist/**",
      "**/dist-test/**",
      "**/node_modules/**",
      "**/.data/**",
      "**/.turbo/**",
      "**/.markgate/**",
      "**/docs/archive/**",
      "**/refer/**",
      "**/reports/**",
      "**/outputs/**",
      "**/work/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
